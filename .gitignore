# Only track skills, agents, and docs
# Ignore everything else by default
*

# Track these
!.gitignore
!README.md
!assets/
!assets/*
!commands/
!commands/*.md
!agents/
!agents/*.md
!skills/
!skills/*/
!skills/paper-init/common/
!skills/*/*.md
!skills/*/references/
!skills/*/references/*.md
!skills/polish/references/
!skills/polish/references/*.md
!skills/polish/scripts/
!skills/polish/scripts/*.py
!skills/**/*.tmpl
!skills/**/publishers/
!skills/**/publishers/*/
!skills/**/publishers/*/*.tmpl
!skills/**/templates/
!skills/**/templates/*
!skills/**/*.sh.tmpl
!skills/**/*.json.tmpl
!skills/**/*.tex.tmpl
!skills/**/*.sh
!skills/**/*.tex
!skills/**/*.py
!skills/**/*.json
!config/
!config/**
# scheduled/ → see github.com/zylen97/idea-scout/pipeline
!skills_pipeline.pdf
!skills_pipeline.tex

# Track the whole skills tree (scripts, tests, profiles, templates, assets) except junk
!skills/**
skills/**/__pycache__/
skills/**/*.pyc
skills/**/.DS_Store
# Licensed journal-ranking table used by lit-screen: provide locally, do not publish
skills/lit-screen/data/
skills/figure-harvest/claude_figure_harvest_backup/

# Sensitive files — never track
CLAUDE.md
settings.json
settings.local.json
memory/

# Never track these even if unignored above
*.backup
cache/
debug/
file-history/
history.jsonl
ide/
paste-cache/
plans/
plugins/
projects/
session-env/
shell-snapshots/
stats-cache.json
statsig/
tasks/
telemetry/
todos/
backups/
mcp-scripts/
